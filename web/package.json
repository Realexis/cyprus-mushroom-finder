{
  "name": "cyprus-mushroom-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-words.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:words": "node scripts/check-words.mjs",
    "predev": "node scripts/copy-worker.mjs && node scripts/views.mjs",
    "prebuild": "node scripts/copy-worker.mjs",
    "postbuild": "node scripts/zip-pmtiles-names.mjs && node scripts/lite-prune.mjs && node scripts/views.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
